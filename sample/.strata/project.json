  "views": [
    {
      "name": "active_users",
      "sql": "SELECT u.name, u.country, COUNT(*) AS events FROM users u JOIN events e ON e.user_id = u.user_id GROUP BY u.name, u.country ORDER BY events DESC"
    },
    {
      "name": "revenue_by_region",
      "sql": "SELECT r.region, SUM(e.amount) AS revenue, COUNT(*) AS n FROM events e JOIN users u ON u.user_id = e.user_id JOIN regions r ON r.country = u.country WHERE e.amount IS NOT NULL GROUP BY r.region ORDER BY revenue DESC"
    }
  ],
