    "mono": "JetBrains Mono"
  },
  "typography": {
    "title": { "family": "ui", "weight": 600, "size": 14.5 },
    "strong_body": { "family": "ui", "weight": 600, "size": 13 },
    "body_medium": { "family": "ui", "weight": 500, "size": 13 },
    "control": { "family": "ui", "weight": 600, "size": 12.5 },
    "body": { "family": "ui", "weight": 400, "size": 12.5, "line_height": 1.55 },
    "caption": { "family": "ui", "weight": 400, "size": 11 },
    "data_value": { "family": "mono", "weight": 500, "size": 12.5 },
    "code_block": { "family": "mono", "weight": 400, "size": 12, "line_height": 1.6 },
    "field_label": { "family": "mono", "weight": 600, "size": 10, "letter_spacing": 0.8 },
