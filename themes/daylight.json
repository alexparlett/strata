    "operator": "#5f6771",
    "property": "#1a1c22",
    "punctuation": "#5f6771",
    "punctuation.bracket": "#5f6771",
    "punctuation.delimiter": "#5f6771",
    "punctuation.special": "#5f6771",
    "string": "#0a3069",
    "string.escape": "#0a3069",
    "string.special": "#0a3069",
    "tag": "#cf222e",
    "text.literal": "#0a3069",
    "text.reference": "#8250df",
    "text.title": "#1a1c22",
    "text.uri": "#0a3069",
    "text.emphasis": "#1a1c22",
